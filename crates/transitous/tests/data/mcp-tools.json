            "arrival": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Absent at the first stop."
            },
            "cancelled": {
              "description": "Whether the trip skips this stop.",
              "type": "boolean"
            },
            "departure": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Absent at the last stop."
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "scheduled_track": {
              "type": [
                "string",
                "null"
              ]
            },
            "track": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "cancelled"
          ],
          "type": "object"
        },
        "Period": {
          "description": "A period of an alert. An absent end means until further notice.",
          "properties": {
            "end": {
              "type": [
                "string",
                "null"
              ]
            },
            "start": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "Time": {
          "description": "A time by the schedule and the expected or actual one.",
          "properties": {
            "actual": {
              "description": "The best known time: with realtime data the expected or actual one,\nelse the schedule.",
              "type": "string"
            },
            "delay_minutes": {
              "description": "`actual` minus `scheduled`. Absent without realtime data.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "scheduled": {
              "type": "string"
            }
          },
          "required": [
            "scheduled",
            "actual"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "alerts": {
          "items": {
            "$ref": "#/$defs/Alert"
          },
          "type": "array"
        },
        "attribution": {
          "$ref": "#/$defs/Attribution"
        },
        "cancelled": {
          "description": "Whether the trip is cancelled.",
          "type": "boolean"
        },
        "headsign": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
