  {
    "name": "transitous_trip",
    "title": "Connections from A to B",
    "description": "Searches connections between two stops or places, each with departure, arrival, duration, transfers, its legs (with trip_id) and a status: ok, delayed, cancelled, unreachable (a transfer is missed or the first ride has left) or no_realtime, with the reasons. With `arrive_by`, the connections arriving last before `time`, and earlier ones to switch to. Use it to plan or check a route; for one stop's departures use transitous_departures, for one ride with all stops transitous_journey. `page_cursor.earlier` and `later` page through more. Counts against the limit of 20 requests per minute (answer rate_limited with retry_after_seconds); each call is also one of the plan requests of the daily limit (default 720, answer daily_limit). Answers are cached for 60 seconds; ask every few minutes at most for the same trip.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "arrive_by": {
          "default": false,
          "description": "Arrive by `time`. The connections arriving last before it come with\nearlier ones, to switch to.",
          "type": "boolean"
        },
        "count": {
          "description": "How many connections to ask for, up to 20. Default 5. Transitous\ncan return more; all are returned, so the page cursors skip none.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "from": {
          "description": "Where from: a stop ID, a stop name that fits one stop, or `LAT,LON`.",
          "type": "string"
        },
        "max_transfers": {
          "description": "The most transfers, like 0 for direct connections only. Default: no\nlimit.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "modes": {
          "default": [],
          "description": "Only these transit modes, like `[\"rail\", \"subway\"]`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "page_cursor": {
          "description": "The page before or after: `page_cursor.earlier` or `later` of the\nprevious result, with the same other arguments.",
          "type": [
            "string",
            "null"
          ]
        },
        "realtime_routing": {
          "default": false,
          "description": "Route on the realtime timetable: cancelled rides and missed transfers\nthen drop out instead of being reported.",
          "type": "boolean"
        },
        "time": {
          "description": "Depart at this time, or arrive by it with `arrive_by`: RFC 3339 with\nan offset, or HH:MM today or a local time like 2026-11-27T07:50 at the\norigin, or at the destination with `arrive_by`. Default now.",
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "description": "Where to, like `from`.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Alert": {
          "description": "A service alert.",
          "properties": {
            "description": {
              "type": "string"
            },
            "effect": {
              "description": "Like `NO_SERVICE` or `DETOUR`.",
              "type": [
                "string",
                "null"
              ]
            },
            "header": {
              "type": "string"
            },
            "periods": {
              "description": "When the alert applies.",
              "items": {
                "$ref": "#/$defs/Period"
              },
              "type": "array"
            },
            "severity": {
              "description": "`INFO`, `WARNING` or `SEVERE`.",
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "header"
          ],
          "type": "object"
        },
        "Attribution": {
          "description": "The data sources and the terms of Transitous. Keep it with the data.",
          "properties": {
            "sources_url": {
              "description": "The timetable sources and their licenses.",
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "usage_rules_url": {
              "description": "The usage rules of the API.",
              "type": "string"
            }
          },
          "required": [
            "text",
            "sources_url",
            "usage_rules_url"
          ],
          "type": "object"
        },
        "Connection": {
          "description": "A connection with its status.",
          "properties": {
            "arrival": {
              "$ref": "#/$defs/Time"
            },
            "departure": {
              "$ref": "#/$defs/Time"
            },
            "duration_minutes": {
              "format": "int64",
              "type": "integer"
            },
            "legs": {
              "items": {
                "$ref": "#/$defs/Leg"
              },
              "type": "array"
            },
            "max_delay_minutes": {
              "description": "The largest delay of a ride, at departure or arrival.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "realtime": {
              "$ref": "#/$defs/Realtime",
              "description": "Whether the rides have realtime data: all, some or none."
            },
            "reasons": {
              "description": "Why the status is not `ok`, most important first.",
              "items": {
                "$ref": "#/$defs/Reason"
              },
              "type": "array"
            },
            "status": {
              "$ref": "#/$defs/Status",
              "description": "What the caller has to know first; see the reasons."
            },
            "transfers": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "status",
            "reasons",
            "realtime",
            "departure",
            "arrival",
            "duration_minutes",
            "transfers",
            "legs"
          ],
          "type": "object"
        },
        "Leg": {
          "description": "One leg of a connection: a ride or a walk.",
          "properties": {
            "alerts": {
              "items": {
                "$ref": "#/$defs/Alert"
              },
              "type": "array"
            },
            "cancelled": {
              "description": "Whether the trip is cancelled.",
              "type": "boolean"
            },
            "duration_minutes": {
              "format": "int64",
              "type": "integer"
            },
            "from": {
              "$ref": "#/$defs/StopEvent"
            },
            "headsign": {
              "type": [
                "string",
                "null"
