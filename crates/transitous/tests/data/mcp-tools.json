  {
    "name": "transitous_trip",
    "description": "Connections between two stops or places, each with a status: ok, delayed, cancelled, unreachable (a transfer is missed or the first ride has left) or no_realtime, with the reasons. With arrive_by, also the earlier connections.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "arrive_by": {
          "default": false,
          "description": "Arrive by `time`. The connections arriving last before it come with\nearlier ones, to switch to.",
          "type": "boolean"
        },
        "count": {
          "description": "How many connections to ask for, up to 20. Default 5. Transitous\ncan return more; all are returned, so the page cursors skip none.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "from": {
          "description": "Where from: a stop ID, a stop name that fits one stop, or `LAT,LON`.",
          "type": "string"
        },
        "max_transfers": {
          "description": "The most transfers.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "modes": {
          "default": [],
          "description": "Only these transit modes, like `[\"rail\", \"subway\"]`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "page_cursor": {
          "description": "The page before or after, from `page_cursor` of a result.",
          "type": [
            "string",
            "null"
          ]
        },
        "realtime_routing": {
          "default": false,
          "description": "Route on the realtime timetable: cancelled rides and missed transfers\nthen drop out instead of being reported.",
          "type": "boolean"
        },
        "time": {
          "description": "Depart at this time, or arrive by it with `arrive_by`: RFC 3339, a\nlocal time or HH:MM today. Default now.",
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "description": "Where to, like `from`.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Alert": {
          "description": "A service alert.",
          "properties": {
            "description": {
              "type": "string"
            },
            "effect": {
              "description": "Like `NO_SERVICE` or `DETOUR`.",
              "type": [
                "string",
                "null"
              ]
            },
            "header": {
              "type": "string"
            },
            "periods": {
              "description": "When the alert applies.",
              "items": {
                "$ref": "#/$defs/Period"
              },
              "type": "array"
            },
            "severity": {
              "description": "`INFO`, `WARNING` or `SEVERE`.",
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "header"
          ],
          "type": "object"
        },
        "Attribution": {
          "description": "The data sources and the terms of Transitous. Keep it with the data.",
          "properties": {
            "sources_url": {
              "description": "The timetable sources and their licenses.",
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "usage_rules_url": {
              "description": "The usage rules of the API.",
              "type": "string"
            }
          },
          "required": [
            "text",
            "sources_url",
            "usage_rules_url"
          ],
          "type": "object"
        },
        "Connection": {
          "description": "A connection with its status.",
          "properties": {
            "arrival": {
              "$ref": "#/$defs/Time"
            },
            "departure": {
              "$ref": "#/$defs/Time"
            },
            "duration_minutes": {
              "format": "int64",
              "type": "integer"
            },
            "legs": {
              "items": {
                "$ref": "#/$defs/Leg"
              },
              "type": "array"
            },
            "max_delay_minutes": {
              "description": "The largest delay of a ride, at departure or arrival.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "realtime": {
              "$ref": "#/$defs/Realtime",
              "description": "Whether the rides have realtime data: all, some or none."
            },
            "reasons": {
              "description": "Why the status is not `ok`, most important first.",
              "items": {
                "$ref": "#/$defs/Reason"
              },
              "type": "array"
            },
            "status": {
              "$ref": "#/$defs/Status",
              "description": "What the caller has to know first; see the reasons."
            },
            "transfers": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "status",
            "reasons",
            "realtime",
            "departure",
            "arrival",
            "duration_minutes",
            "transfers",
            "legs"
          ],
          "type": "object"
        },
        "Leg": {
          "description": "One leg of a connection: a ride or a walk.",
          "properties": {
            "alerts": {
              "items": {
                "$ref": "#/$defs/Alert"
              },
              "type": "array"
            },
            "cancelled": {
              "description": "Whether the trip is cancelled.",
              "type": "boolean"
            },
            "duration_minutes": {
              "format": "int64",
              "type": "integer"
            },
            "from": {
              "$ref": "#/$defs/StopEvent"
            },
            "headsign": {
              "type": [
                "string",
                "null"
              ]
            },
            "line": {
              "description": "The line, like `U5`.",
              "type": [
                "string",
                "null"
              ]
            },
            "mode": {
              "description": "Like `SUBWAY`, `BUS` or `WALK`.",
              "type": "string"
            },
            "operator": {
              "type": [
                "string",
                "null"
              ]
            },
            "realtime": {
              "description": "Whether realtime data exists for this leg.",
              "type": "boolean"
            },
            "stay_seated": {
              "description": "Whether passengers stay in the vehicle from the previous leg.",
              "type": "boolean"
            },
            "to": {
              "$ref": "#/$defs/StopEvent"
            },
            "trip_id": {
              "description": "For `transitous journey`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "mode",
            "from",
            "to",
            "duration_minutes",
            "realtime",
            "cancelled"
          ],
          "type": "object"
        },
        "Location": {
          "description": "A stop of a connection or departure.",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "PageCursor": {
          "description": "Cursors for the next page, to pass as `page_cursor`.",
          "properties": {
            "earlier": {
              "type": [
                "string",
                "null"
              ]
            },
            "later": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "Period": {
          "description": "A period of an alert. An absent end means until further notice.",
          "properties": {
            "end": {
              "type": [
                "string",
                "null"
              ]
            },
            "start": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "Realtime": {
          "description": "How much of a connection has realtime data.",
          "oneOf": [
            {
