[
  {
    "name": "transitous_departures",
    "title": "Departures at a stop",
    "description": "Lists the next departures, or with `arrivals` the arrivals, at one stop from `time` on: each with mode, line, operator, headsign, planned and realtime time, delay, track, cancellation of the stop or the whole ride, and alerts, and the trip_id for transitous_journey. Use it for what leaves a stop soon; to get from A to B with transfers use transitous_trip, for all stops of one ride transitous_journey. `page_cursor.earlier` and `later` of the result page through more. Counts against the limit of 20 requests per minute (answer rate_limited with retry_after_seconds); answers are cached for 60 seconds.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "arrivals": {
          "default": false,
          "description": "Arrivals instead of departures.",
          "type": "boolean"
        },
        "count": {
          "description": "How many departures to ask for, up to 100. Default 10. Transitous\ncan return more.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "modes": {
          "default": [],
          "description": "Only these modes, like `[\"subway\", \"bus\"]`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "page_cursor": {
          "description": "The page before or after: `page_cursor.earlier` or `later` of the\nprevious result, with the same other arguments.",
          "type": [
            "string",
            "null"
          ]
        },
        "stop": {
          "description": "The stop: its ID, or a name that fits one stop.",
          "type": "string"
        },
        "time": {
          "description": "From this time: RFC 3339 with an offset, or HH:MM today or a local\ntime like 2026-11-27T07:50 at the stop. Default now.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "stop"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Alert": {
          "description": "A service alert.",
          "properties": {
            "description": {
              "type": "string"
            },
            "effect": {
              "description": "Like `NO_SERVICE` or `DETOUR`.",
              "type": [
                "string",
                "null"
              ]
            },
            "header": {
              "type": "string"
            },
            "periods": {
              "description": "When the alert applies.",
              "items": {
                "$ref": "#/$defs/Period"
              },
              "type": "array"
            },
            "severity": {
              "description": "`INFO`, `WARNING` or `SEVERE`.",
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "header"
          ],
          "type": "object"
        },
        "Attribution": {
          "description": "The data sources and the terms of Transitous. Keep it with the data.",
          "properties": {
            "sources_url": {
              "description": "The timetable sources and their licenses.",
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "usage_rules_url": {
              "description": "The usage rules of the API.",
              "type": "string"
            }
          },
          "required": [
            "text",
            "sources_url",
            "usage_rules_url"
          ],
          "type": "object"
        },
        "Departure": {
          "description": "A departure or arrival at a stop.",
          "properties": {
            "alerts": {
              "items": {
                "$ref": "#/$defs/Alert"
              },
              "type": "array"
            },
            "cancelled": {
              "description": "Whether this departure or arrival is cancelled.",
              "type": "boolean"
            },
            "headsign": {
              "type": [
                "string",
                "null"
              ]
            },
            "line": {
              "type": [
                "string",
                "null"
              ]
            },
            "mode": {
              "type": "string"
            },
            "operator": {
              "type": [
                "string",
                "null"
              ]
            },
            "realtime": {
              "type": "boolean"
            },
            "stop": {
              "$ref": "#/$defs/StopEvent",
              "description": "The stop or platform, with the time of the departure or arrival."
            },
            "trip_cancelled": {
              "description": "Whether the whole trip is cancelled.",
              "type": "boolean"
            },
            "trip_id": {
              "description": "For `transitous journey`.",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "trip_id",
            "stop",
            "realtime",
            "cancelled",
            "trip_cancelled"
          ],
          "type": "object"
        },
        "Location": {
          "description": "A stop of a connection or departure.",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "PageCursor": {
          "description": "Cursors for the next page, to pass as `page_cursor`.",
          "properties": {
            "earlier": {
              "type": [
                "string",
                "null"
              ]
            },
            "later": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "Period": {
          "description": "A period of an alert. An absent end means until further notice.",
          "properties": {
            "end": {
              "type": [
                "string",
                "null"
              ]
            },
            "start": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "StopEvent": {
          "description": "Where a leg starts or ends.",
          "properties": {
            "actual": {
              "description": "The best known time: with realtime data the expected or actual one,\nelse the schedule.",
              "type": "string"
            },
            "cancelled": {
              "description": "Whether boarding or alighting here is cancelled.",
              "type": "boolean"
            },
            "delay_minutes": {
              "description": "`actual` minus `scheduled`. Absent without realtime data.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "scheduled": {
              "type": "string"
            },
            "scheduled_track": {
              "type": [
                "string",
                "null"
              ]
            },
            "track": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "scheduled",
            "actual",
            "cancelled"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "arrivals": {
          "description": "Whether these are arrivals instead of departures.",
          "type": "boolean"
        },
        "attribution": {
          "$ref": "#/$defs/Attribution"
        },
        "departures": {
          "items": {
            "$ref": "#/$defs/Departure"
          },
          "type": "array"
        },
        "page_cursor": {
          "$ref": "#/$defs/PageCursor"
        },
        "stop": {
          "$ref": "#/$defs/Location"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "stop",
        "arrivals",
        "departures",
        "page_cursor",
        "attribution",
        "warnings"
      ],
      "type": "object"
    },
    "annotations": {
      "title": "Departures at a stop",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "transitous_find_stop",
    "title": "Find a stop",
    "description": "Searches stops by name, or a part of it, and returns up to `count` matches (default 10, at most 20), each with stop ID, name, area, coordinates and modes; `near` ranks stops close to a place first. Use it to get a stop ID, or when a name is ambiguous: transitous_departures and transitous_trip also take a name that fits one stop, and answer ambiguous_stop with candidates otherwise. Counts against the limit of 20 requests per minute (answer rate_limited with retry_after_seconds); answers are cached for 15 minutes.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "count": {
          "description": "The most stops, up to 20. Default 10.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "The name of the stop, or a part of it, like `Frankfurt Hbf` or\n`Hauptwache`.",
          "type": "string"
        },
        "near": {
          "description": "Prefer stops near this place, as `LAT,LON` like `50.11,8.68`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Attribution": {
          "description": "The data sources and the terms of Transitous. Keep it with the data.",
          "properties": {
            "sources_url": {
              "description": "The timetable sources and their licenses.",
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "usage_rules_url": {
              "description": "The usage rules of the API.",
              "type": "string"
            }
          },
          "required": [
            "text",
            "sources_url",
            "usage_rules_url"
          ],
          "type": "object"
        },
        "StopMatch": {
          "description": "A stop, as found by name.",
          "properties": {
            "area": {
              "description": "The town or district, to tell stops of the same name apart.",
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "description": "The ID to pass instead of the name.",
              "type": "string"
            },
            "lat": {
              "format": "double",
              "type": "number"
            },
            "lon": {
              "format": "double",
              "type": "number"
            },
            "modes": {
              "description": "The modes that serve the stop, like `SUBWAY`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "lat",
            "lon",
            "modes"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Attribution"
        },
        "query": {
          "type": "string"
        },
        "stops": {
          "items": {
            "$ref": "#/$defs/StopMatch"
          },
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "query",
        "stops",
        "attribution",
        "warnings"
      ],
      "type": "object"
    },
    "annotations": {
      "title": "Find a stop",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "transitous_journey",
    "title": "One ride with all stops",
    "description": "Returns one ride (a vehicle's trip) with line, operator, headsign, whether it is cancelled, its alerts, and every stop with planned and realtime times, delays, tracks and cancelled stops. Takes the trip_id of a departure from transitous_departures or of a leg from transitous_trip. Use it to follow a train along its route or to see where a delay starts. Counts against the limit of 20 requests per minute (answer rate_limited with retry_after_seconds); answers are cached for 60 seconds.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "trip_id": {
          "description": "The trip ID, from `trip_id` of a departure of\n`transitous_departures` or a leg of `transitous_trip`, as it is.",
          "type": "string"
        }
      },
      "required": [
        "trip_id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Alert": {
          "description": "A service alert.",
          "properties": {
            "description": {
              "type": "string"
            },
            "effect": {
              "description": "Like `NO_SERVICE` or `DETOUR`.",
              "type": [
                "string",
                "null"
              ]
            },
            "header": {
              "type": "string"
            },
            "periods": {
              "description": "When the alert applies.",
              "items": {
                "$ref": "#/$defs/Period"
              },
              "type": "array"
            },
            "severity": {
              "description": "`INFO`, `WARNING` or `SEVERE`.",
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "header"
          ],
          "type": "object"
        },
        "Attribution": {
          "description": "The data sources and the terms of Transitous. Keep it with the data.",
          "properties": {
            "sources_url": {
              "description": "The timetable sources and their licenses.",
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "usage_rules_url": {
              "description": "The usage rules of the API.",
              "type": "string"
            }
          },
          "required": [
            "text",
            "sources_url",
            "usage_rules_url"
          ],
          "type": "object"
        },
        "JourneyStop": {
          "description": "A stop of a trip.",
