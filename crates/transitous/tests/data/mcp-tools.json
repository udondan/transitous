[
  {
    "name": "transitous_departures",
    "description": "The next departures or arrivals at a stop, with realtime times, delays, cancellations and alerts.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "arrivals": {
          "default": false,
          "description": "Arrivals instead of departures.",
          "type": "boolean"
        },
        "count": {
          "description": "How many departures to ask for, up to 100. Default 10. Transitous\ncan return more.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "modes": {
          "default": [],
          "description": "Only these modes, like `[\"subway\", \"bus\"]`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "page_cursor": {
          "description": "The page before or after, from `page_cursor` of a result.",
          "type": [
            "string",
            "null"
          ]
        },
        "stop": {
          "description": "The stop: its ID, or a name that fits one stop.",
          "type": "string"
        },
        "time": {
          "description": "From this time: RFC 3339, a local time or HH:MM today. Default now.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "stop"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Alert": {
          "description": "A service alert.",
          "properties": {
            "description": {
              "type": "string"
            },
            "effect": {
              "description": "Like `NO_SERVICE` or `DETOUR`.",
              "type": [
                "string",
                "null"
              ]
            },
            "header": {
              "type": "string"
            },
            "periods": {
              "description": "When the alert applies.",
              "items": {
                "$ref": "#/$defs/Period"
              },
              "type": "array"
            },
            "severity": {
              "description": "`INFO`, `WARNING` or `SEVERE`.",
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "header"
          ],
          "type": "object"
        },
        "Attribution": {
          "description": "The data sources and the terms of Transitous. Keep it with the data.",
          "properties": {
            "sources_url": {
              "description": "The timetable sources and their licenses.",
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "usage_rules_url": {
              "description": "The usage rules of the API.",
              "type": "string"
            }
          },
          "required": [
            "text",
            "sources_url",
            "usage_rules_url"
          ],
          "type": "object"
        },
        "Departure": {
          "description": "A departure or arrival at a stop.",
          "properties": {
            "alerts": {
              "items": {
                "$ref": "#/$defs/Alert"
              },
              "type": "array"
            },
            "cancelled": {
              "description": "Whether this departure or arrival is cancelled.",
              "type": "boolean"
            },
            "headsign": {
              "type": [
                "string",
                "null"
              ]
            },
            "line": {
              "type": [
                "string",
                "null"
              ]
            },
            "mode": {
              "type": "string"
            },
            "operator": {
              "type": [
                "string",
                "null"
              ]
            },
            "realtime": {
              "type": "boolean"
            },
            "stop": {
              "$ref": "#/$defs/StopEvent",
              "description": "The stop or platform, with the time of the departure or arrival."
            },
            "trip_cancelled": {
              "description": "Whether the whole trip is cancelled.",
              "type": "boolean"
            },
            "trip_id": {
              "description": "For `transitous journey`.",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "trip_id",
            "stop",
            "realtime",
            "cancelled",
            "trip_cancelled"
          ],
          "type": "object"
        },
        "Location": {
          "description": "A stop of a connection or departure.",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "PageCursor": {
          "description": "Cursors for the next page, to pass as `page_cursor`.",
          "properties": {
            "earlier": {
              "type": [
                "string",
                "null"
              ]
            },
            "later": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "Period": {
          "description": "A period of an alert. An absent end means until further notice.",
          "properties": {
            "end": {
              "type": [
                "string",
                "null"
              ]
            },
            "start": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "StopEvent": {
          "description": "Where a leg starts or ends.",
          "properties": {
            "actual": {
              "description": "The best known time: with realtime data the expected or actual one,\nelse the schedule.",
              "type": "string"
            },
            "cancelled": {
              "description": "Whether boarding or alighting here is cancelled.",
              "type": "boolean"
            },
            "delay_minutes": {
              "description": "`actual` minus `scheduled`. Absent without realtime data.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "scheduled": {
              "type": "string"
            },
            "scheduled_track": {
              "type": [
                "string",
                "null"
              ]
            },
            "track": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "scheduled",
            "actual",
            "cancelled"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "arrivals": {
          "description": "Whether these are arrivals instead of departures.",
          "type": "boolean"
        },
        "attribution": {
          "$ref": "#/$defs/Attribution"
        },
        "departures": {
          "items": {
            "$ref": "#/$defs/Departure"
          },
          "type": "array"
        },
        "page_cursor": {
          "$ref": "#/$defs/PageCursor"
        },
        "stop": {
          "$ref": "#/$defs/Location"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "stop",
        "arrivals",
        "departures",
        "page_cursor",
        "attribution",
        "warnings"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "transitous_find_stop",
    "description": "Find stops by name, with their IDs for the other tools.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "count": {
          "description": "The most stops, up to 20. Default 10.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "The name of the stop, or a part of it.",
          "type": "string"
        },
        "near": {
          "description": "Prefer stops near this place, as `LAT,LON` like `50.11,8.68`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Attribution": {
          "description": "The data sources and the terms of Transitous. Keep it with the data.",
          "properties": {
            "sources_url": {
              "description": "The timetable sources and their licenses.",
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "usage_rules_url": {
              "description": "The usage rules of the API.",
              "type": "string"
            }
          },
          "required": [
            "text",
            "sources_url",
            "usage_rules_url"
          ],
          "type": "object"
        },
        "StopMatch": {
          "description": "A stop, as found by name.",
          "properties": {
            "area": {
              "description": "The town or district, to tell stops of the same name apart.",
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "description": "The ID to pass instead of the name.",
              "type": "string"
            },
            "lat": {
              "format": "double",
              "type": "number"
            },
            "lon": {
              "format": "double",
              "type": "number"
            },
            "modes": {
              "description": "The modes that serve the stop, like `SUBWAY`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "lat",
            "lon",
            "modes"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Attribution"
        },
        "query": {
          "type": "string"
        },
        "stops": {
          "items": {
            "$ref": "#/$defs/StopMatch"
          },
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "query",
        "stops",
        "attribution",
        "warnings"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    }
  },
  {
