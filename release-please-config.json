{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "bootstrap-sha": "22686a04bd707e28f42474c60b40b3d761ac0b42",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "draft": true,
  "force-tag-creation": true,
  "prerelease": false,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "feature",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "build",
      "scope": "deps",
      "section": "Dependencies"
    },
    {
      "type": "deps",
      "section": "Dependencies",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous Chores",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Styles",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Code Refactoring",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build System",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": true
    }
  ],
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": true
    }
  ],
  "packages": {
    "crates/motis": {
      "component": "motis",
      "exclude-paths": [
        "crates/motis/tests"
      ]
    },
    "crates/transitous-core": {
      "component": "transitous-core",
      "exclude-paths": [
        "crates/transitous-core/tests"
      ]
    },
    "crates/motis-sim": {
      "component": "motis-sim",
      "exclude-paths": [
        "crates/motis-sim/tests"
      ]
    },
    "crates/transitous": {
      "component": "transitous",
      "exclude-paths": [
        "crates/transitous/tests"
      ]
    }
  }
}
