#!/usr/bin/env bash
# Runs the qlty checks of CI before a commit, so findings show up locally
# instead of on the pull request. Install with `make hooks`.
set -euo pipefail

if ! command -v qlty >/dev/null; then
    echo "qlty is not installed, see https://docs.qlty.sh/cli/quickstart" >&2
    exit 1
fi

qlty check --all

# Like make: the stable toolchain of rustup first, whose rustfmt is the one
# of CI. A packaged toolchain, like Homebrew's, can be older.
if command -v rustup >/dev/null; then
    PATH="$(dirname "$(rustup which --toolchain stable cargo)"):$PATH"
fi

# qlty does not run rustfmt, which CI checks in `make lint`.
if ! cargo fmt --all --check >/dev/null; then
    echo "cargo fmt would change files; run cargo fmt --all" >&2
    exit 1
fi

# Like CI: only smells that are new compared to main block the commit.
upstream=origin/main
smells=$(qlty smells --upstream "$upstream" --json --quiet 2>/dev/null | jq length)
if [ "$smells" -gt 0 ]; then
    qlty smells --upstream "$upstream" --no-snippets
    echo "qlty found $smells new code smell(s) compared to $upstream" >&2
    exit 1
fi

# Like CI: actionlint (with shellcheck) and zizmor, in the versions of
# mise.toml, when the commit changes the workflows. zizmor runs
# offline here; CI also runs its online audits.
if git diff --cached --name-only | grep -qE '^\.github/|^mise\.toml$'; then
    if ! command -v mise >/dev/null; then
        echo "mise is not installed, see https://mise.jdx.dev" >&2
        exit 1
    fi
    mise exec -- actionlint
    mise exec -- zizmor --offline --quiet .
fi
